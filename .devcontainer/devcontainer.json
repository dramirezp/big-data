{
  "name": "Big Data",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "Jupyter Notebook" }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
